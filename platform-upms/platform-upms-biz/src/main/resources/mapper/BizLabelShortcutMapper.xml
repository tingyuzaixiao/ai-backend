<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.train.platform.admin.mapper.BizLabelShortcutMapper">

    <resultMap id="BaseResultMap" type="com.train.platform.admin.api.entity.BizLabelShortcut">
            <id property="shortcutId" column="shortcut_id" />
            <result property="userId" column="user_id" />
            <result property="generalShortcut" column="general_shortcut" />
            <result property="classifyShortcut" column="classify_shortcut" />
            <result property="detectShortcut" column="detect_shortcut" />
            <result property="segmentShortcut" column="segment_shortcut" />
            <result property="createTime" column="create_time" />
            <result property="createBy" column="create_by" />
            <result property="updateTime" column="update_time" />
            <result property="updateBy" column="update_by" />
    </resultMap>

    <sql id="Base_Column_List">
        shortcut_id,user_id,general_shortcut,classify_shortcut,detect_shortcut,segment_shortcut,create_time,
        create_by,update_time,update_by
    </sql>
	<select id="getShortcutByPage" resultMap="BaseResultMap">
        select shortcut_id,user_id,general_shortcut,classify_shortcut,detect_shortcut,segment_shortcut,create_time,
        create_by,update_time,update_by
        from aircas_label_shortcut
        <where>
            del_flag = '0'
            <if test="shortcutId != null and shortcutId != ''">
                and shortcut_id = #{shorcutId}
            </if>
            <if test="userId != null and userId != ''">
                and user_id = #{userId}
            </if>
        </where>
    </select>
</mapper>
