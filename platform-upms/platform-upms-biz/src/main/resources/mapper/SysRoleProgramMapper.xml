<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.train.platform.admin.mapper.SysRoleProgramMapper">

    <resultMap id="BaseResultMap" type="com.train.platform.admin.api.entity.SysRoleProgram">
            <result property="roleId" column="role_id" jdbcType="BIGINT"/>
            <result property="programId" column="program_id" jdbcType="BIGINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        role_id,program_id
    </sql>
	<delete id="deleteByIds">
		delete from sys_role_program where program_id in
		<foreach collection="ids" item="id" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>
	<delete id="deleteById">
		delete from sys_role_program where program_id = #{id}
	</delete>
</mapper>
