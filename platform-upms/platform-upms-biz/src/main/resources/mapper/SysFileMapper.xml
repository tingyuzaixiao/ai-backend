	<select id="selectListInFileIds" resultType="com.train.platform.admin.api.entity.SysFile">
		select select
		<include refid="Base_Column_List"/>
		from sys_file
		where id in
		<foreach collection="list" item="item" index="index" open="(" separator="," close=")">
			#{item}
		</foreach>
	</select>
	<select id="selectListInFileIdStr" resultMap="BaseResultMap">
		select select
		<include refid="Base_Column_List"/>
		from sys_file
		where id in (${fileIdStr})
	</select>
	<select id="selectSysFilesPage" resultMap="BaseResultMap">
		select
		sf.id as
		file_id,sf.base_dataset_id,sf.file_name,sf.md5,sf.file_size,sf.height,sf.width,sf.create_time,sf.bucket_name,
		sf.original,sf.type
		from sys_file sf
		<where>
			sf.del_flag = '0'
			<if test="query.fileName != null and query.fileName != ''">
				<bind name="fileNameLike" value="'%'+query.fileName+'%'"/>
				AND sf.file_name LIKE #{fileNameLike}
			</if>
			<if test="query.original != null and query.original != ''">
				<bind name="originalLike" value="'%'+query.original+'%'"/>
				AND sf.original LIKE #{originalLike}
			</if>
			<if test="query.bucketName != null and query.bucketName != ''">
				<bind name="bucketNameLike" value="'%'+query.bucketName+'%'"/>
				AND sf.bucket_name LIKE #{bucketNameLike}
			</if>
			<if test="query.baseDatasetId != null and query.baseDatasetId != ''">
				AND sf.base_dataset_id = #{query.baseDatasetId}
			</if>
			<if test="query.type != null and query.type != ''">
				AND sf.type = #{query.type}
			</if>
			<!--            <if test="query.taskId != null and query.taskId != ''">-->
			<!--                AND al.task_id = #{query.taskId}-->
			<!--            </if>-->
			<!--			<if test="query.tagId != null and query.tagId != ''">-->
			<!--				AND al.tag_id like concat('%',#{query.tagId},'%')-->
			<!--			</if>-->
		</where>
		order by sf.id desc,sf.original asc

		<!--        <if test="_databaseId != 'mssql'">-->
		<!--            ORDER BY create_time DESC-->
		<!--        </if>-->
	</select>
	<select id="sumFileSizeByFileIds" resultType="java.lang.Long"
			parameterType="java.util.List">
		select sum(file_size) from sys_file
		where id in
		<foreach collection="list" item="item" index="index" open="(" separator="," close=")">
			#{item}
		</foreach>
	</select>
	<select id="selectFileVOList" resultMap="FileVOResultMap2">
		select sf.id as file_id,sf.base_dataset_id,sf.file_name,sf.bucket_name,sf.original,sf.file_size,sf.type
		,#{query.labelFileName} as label_file_name,sf.height,sf.width,sf.create_time
		from sys_file sf
		<where>
			sf.del_flag = '0'
			<if test="query.fileName != null and query.fileName != ''">
				<bind name="fileNameLike" value="'%'+fileName+'%'"/>
				AND file_name LIKE #{fileNameLike}
			</if>
			<if test="query.original != null and query.original != ''">
				<bind name="originalLike" value="'%'+query.original+'%'"/>
				AND original LIKE #{originalLike}
			</if>
			<if test="query.baseDatasetId != null and query.baseDatasetId != ''">
				AND base_dataset_id = #{query.baseDatasetId}
			</if>
			<if test="query.fileIds != null and query.fileIds != ''">
				AND id in
				<foreach collection="query.fileIds" item="item" index="index" open="(" separator="," close=")">
					#{item}
				</foreach>
			</if>
		</where>

		<if test="_databaseId != 'mssql'">
			ORDER BY create_time DESC
		</if>
	</select>
