	<select id="selectNewSysFilesLabeledPage" resultMap="NewFileVOLabelResultMap">
		SELECT
		id AS file_id,
		base_dataset_id,
		file_name,
		md5,
		file_size,
		create_time,
		bucket_name,
		original,
		type
		FROM sys_file
		<where>
			<!-- 确保主表记录存在子表数据 -->
			AND EXISTS (
			SELECT 1
			FROM aircas_label
			WHERE
			file_id = sys_file.id
			AND del_flag = '0'
			<if test="query.labelState != null and query.labelState != ''">
				AND state = #{query.labelState}
			</if>
			<if test="query.fileName != null and query.fileName != ''">
				<bind name="fileNameLike" value="'%'+query.fileName+'%'"/>
				AND file_name LIKE #{fileNameLike}
			</if>
			<if test="query.original != null and query.original != ''">
				<bind name="originalLike" value="'%'+query.original+'%'"/>
				AND original LIKE #{originalLike}
			</if>
			<if test="query.bucketName != null and query.bucketName != ''">
				<bind name="bucketNameLike" value="'%'+query.bucketName+'%'"/>
				AND bucket_name LIKE #{bucketNameLike}
			</if>
			<if test="query.baseDatasetId != null and query.baseDatasetId != ''">
				AND base_dataset_id = #{query.baseDatasetId}
			</if>
			<if test="query.type != null and query.type != ''">
				AND type = #{query.type}
			</if>
			<if test="query.taskId != null and query.taskId != ''">
				AND task_id = #{query.taskId}
			</if>
			<if test="query.tagId != null and query.tagId != ''">
				AND tag_id LIKE CONCAT('%', #{query.tagId}, '%')
			</if>
			<if test="query.description != null and query.description != ''">
				AND description LIKE CONCAT('%', #{query.description}, '%')
			</if>
			)
		</where>
		ORDER BY id DESC, original ASC
	</select>
	<select id="selectNewSysFilesUnLabeledPage0512" resultMap="FileVOLabelResultMap0512">
		SELECT sf.id AS file_id, sf.base_dataset_id, sf.file_name, sf.md5, sf.file_size, sf.create_time, sf.bucket_name,
		sf.original,sf.width,sf.height
		FROM sys_file sf
		<where>
			sf.del_flag = '0'
			<if test="query.fileName != null and query.fileName != ''">
				<bind name="fileNameLike" value="'%'+query.fileName+'%'"/>
				AND sf.file_name LIKE #{fileNameLike}
			</if>
			<if test="query.original != null and query.original != ''">
				<bind name="originalLike" value="'%'+query.original+'%'"/>
				AND sf.original LIKE #{originalLike}
			</if>
			<if test="query.bucketName != null and query.bucketName != ''">
				<bind name="bucketNameLike" value="'%'+query.bucketName+'%'"/>
				AND sf.bucket_name LIKE #{bucketNameLike}
			</if>
			<if test="query.baseDatasetId != null and query.baseDatasetId != ''">
				AND sf.base_dataset_id = #{query.baseDatasetId}
			</if>
			<if test="query.type != null and query.type != ''">
				AND sf.type = #{query.type}
			</if>
			<if test="query.taskId != null and query.taskId != ''">
				AND NOT EXISTS (
				SELECT 1
				FROM aircas_label al
				WHERE al.file_id = sf.id
				AND al.task_id = #{query.taskId}
				AND al.del_flag = '0'
				)
			</if>
		</where>
		order by sf.id desc,sf.original asc
	</select>
	<select id="selectFileOrderIds" resultType="java.lang.Long">
		select id
		from sys_file
		<where>
			<if test="query.baseDatasetId != null and query.baseDatasetId != ''">
				and base_dataset_id = #{query.baseDatasetId}
			</if>
			<if test="query.fileName != null and query.fileName != ''">
				and file_name like concat('%',#{query.fileName},'%')
			</if>
			<if test="query.original != null and query.original != ''">
				and original like concat('%',#{query.original},'%')
			</if>
			<if test="query.bucketName != null and query.bucketName != ''">
				and bucket_name like concat('%',#{query.bucketName},'%')
			</if>
			and del_flag ='0'
		</where>
		order by id desc
	</select>
