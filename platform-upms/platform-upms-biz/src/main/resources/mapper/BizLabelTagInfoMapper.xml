<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.train.platform.admin.mapper.BizLabelTagInfoMapper">

	<resultMap id="BaseResultMap" type="com.train.platform.admin.api.vo.LabelTagInfoVO">
		<id property="tagInfoId" column="tag_info_id" jdbcType="BIGINT"/>
		<result property="labelId" column="label_id" jdbcType="BIGINT"/>
		<result property="tagId" column="tag_id" jdbcType="BIGINT"/>
		<result property="tagInfo" column="tag_info" jdbcType="VARCHAR"/>
		<result property="confidence" column="create_by" jdbcType="VARCHAR"/>
		<result property="score" column="create_time" jdbcType="VARCHAR"/>
	</resultMap>

	<sql id="Base_Column_List">
		tag_info_id
		,label_id,tag_id,
        tag_info,create_by,create_time,
        update_by,update_time,del_flag
	</sql>
	<delete id="deleteByLabelId">
		update aircas_label_tag_info
		set del_flag = '1'
		where label_id = #{labelId}
	</delete>
	<select id="selectByLabelId" resultMap="BaseResultMap"
			parameterType="java.lang.Long">
		select alti.tag_info_id, alti.label_id, alti.tag_id, alti.tag_info
		from aircas_label_tag_info alti
		where alti.label_id = #{labelId}
		  and alti.del_flag = '0'
	</select>
	<select id="selectByLabelIds" resultMap="BaseResultMap">
		select alti.tag_info_id, alti.label_id, alti.tag_id, alti.tag_info
		from aircas_label_tag_info alti
		where alti.label_id in
		<foreach item="item" index="index" collection="list" open="(" separator="," close=")">
			#{item}
		</foreach>
		and alti.del_flag = '0'
	</select>
</mapper>
